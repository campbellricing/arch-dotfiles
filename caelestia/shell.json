{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": true,
            "showOnHover": false
        },
        "clock": {
            "background": false,
            "showDate": true,
            "showIcon": false
        },
        "entries": [
            {
                "enabled": true,
                "id": "logo"
            },
            {
                "enabled": true,
                "id": "workspaces"
            },
            {
                "enabled": true,
                "id": "spacer"
            },
            {
                "enabled": false,
                "id": "activeWindow"
            },
            {
                "enabled": true,
                "id": "clock"
            },
            {
                "enabled": true,
                "id": "spacer"
            },
            {
                "enabled": true,
                "id": "tray"
            },
            {
                "enabled": true,
                "id": "statusIcons"
            },
            {
                "enabled": false,
                "id": "power"
            }
        ],
        "persistent": true,
        "popouts": {
            "activeWindow": false,
            "statusIcons": true,
            "tray": true
        },
        "scrollActions": {
            "brightness": false,
            "volume": false,
            "workspaces": false
        },
        "status": {
            "showAudio": true,
            "showBattery": true,
            "showBluetooth": true,
            "showKbLayout": false,
            "showLockStatus": false,
            "showNetwork": true,
            "showWifi": true
        },
        "tray": {
            "background": false,
            "compact": false,
            "recolour": false
        },
        "workspaces": {
            "activeIndicator": true,
            "activeLabel": "󰫢 ",
            "activeTrail": true,
            "label": "󰫢 ",
            "maxWindowIcons": 4,
            "occupiedBg": false,
            "occupiedLabel": "󰫢 ",
            "perMonitorWorkspaces": true,
            "showWindows": false,
            "showWindowsOnSpecialWorkspaces": false,
            "shown": 4
        }
    },
    "dashboard": {
        "enabled": true,
        "resourceUpdateInterval": 2000,
        "showOnHover": false,
        "showWeather": true
    },
    "general": {
        "apps": {
            "playback": [
                "/usr/bin/vlc",
                "--started-from-file"
            ]
        },
        "logo": "caelestia"
    },
    "launcher": {
        "hiddenApps": [
            "xfce4-about",
            "thunar-bulk-rename",
            "fcitx5-configtool",
            "org.fcitx.fcitx5-migrator",
            "footclient",
            "foot-server",
            "lstopo",
            "kbd-layout-viewer5",
            "libreoffice-base",
            "libreoffice-calc",
            "libreoffice-draw",
            "libreoffice-impress",
            "libreoffice-math",
            "libreoffice-writer",
            "thunar-settings",
            "org.pulseaudio.pavucontrol",
            "org.gnome.Nautilus"
        ],
        "maxShown": 8,
        "maxWallpapers": 8,
        "useFuzzy": {
            "actions": true,
            "apps": true
        },
        "vimKeybinds": true
    },
    "paths": {
        "wallpaperDir": "/home/campbells/.config/images/wallpapers"
    },
    "services": {
        "audioIncrement": 0.02,
        "brightnessIncrement": 0.1,
        "defaultPlayer": "Chromium",
        "useFahrenheit": false,
        "useTwelveHourClock": false
    },
    "session": {
        "commands": {
            "reboot": [
                "systemctl",
                "reboot",
                "--no-wall"
            ],
            "shutdown": [
                "systemctl",
                "poweroff",
                "--no-wall"
            ]
        }
    },
    "sidebar": {
        "enabled": true
    },
    "utilities": {
        "toasts": {
            "kbLayoutChanged": false
        }
    }
}
