{
    "allowDuplicates": false,
    "historyFile": "clipboard_history.json",
    "maxHistory": 100,
    "deleteAfter": 0,
    "logFile": "clipse.log",
    "pollInterval": 50,
    "maxEntryLength": 65,
    "themeFile": "custom_theme.json",
    "tempDir": "tmp_files",
    "keyBindings": {
        "choose": "enter",
        "clearSelected": "S",
        "up": "k,ctrl+p",
        "down": "j,ctrl+n",
        "home": "home",
        "end": "end",
        "filter": "/",
        "forceQuit": "Q",
        "more": "?",
        "nextPage": "l",
        "prevPage": "h",
        "preview": "space",
        "quit": "esc",
        "remove": "backspace",
        "selectSingle": "v",
        "selectUp": "shift+k",
        "selectDown": "shift+j",
        "togglePin": "p",
        "togglePinned": "tab",
        "yankFilter": "ctrl+s"
    },
    "imageDisplay": {
        "type": "basic",
        "scaleX": 9,
        "scaleY": 9,
        "heightCut": 2
    },
    "excludedApps": [],
    "autoPaste": {
        "enabled": false,
        "keybind": "ctrl+v",
        "buffer": 10
    },
    "enableMouse": true,
    "enableDescription": false
}
